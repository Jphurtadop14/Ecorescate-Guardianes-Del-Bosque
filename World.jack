        // Arboles
        if (blockedObject(px, py, 45, 300, 33, 57, 288, 315)) {
            return true;
        }
        if (blockedObject(px, py, 35, 455, 23, 47, 443, 470)) {
            return true;
        }
        if (blockedObject(px, py, 105, 465, 93, 117, 453, 480)) {
            return true;
        }
        if (blockedObject(px, py, 205, 475, 193, 217, 463, 490)) {
            return true;
        }
        if (blockedObject(px, py, 250, 300, 238, 262, 288, 315)) {
            return true;
        }
        if (blockedObject(px, py, 460, 310, 448, 472, 298, 325)) {
            return true;
        }
        if (blockedObject(px, py, 420, 465, 408, 432, 453, 480)) {
            return true;
        }

        // Casa
        if (blockedObject(px, py, 150, 320, 136, 210, 315, 358)) {
            return true;
        }

        // Rocas
        if (overlaps(px, py, 420, 440, 340, 360)) {
            return true;
        }
        if (overlaps(px, py, 290, 310, 290, 310)) {
            return true;
        }

        // Estanque
        if (overlaps(px, py, 335, 385, 330, 380)) {
            return true;
        }

        return false;
    }

    // =====================================
    // COLISIONES DE LA MONTANA ROCOSA
    // =====================================


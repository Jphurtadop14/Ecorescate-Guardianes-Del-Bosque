        }
        if (blockedObject(px, py, 720, 45, 708, 732, 33, 60)) {
            return true;
        }
        if (blockedObject(px, py, 890, 55, 878, 902, 43, 70)) {
            return true;
        }
        if (blockedObject(px, py, 970, 55, 958, 982, 43, 70)) {
            return true;
        }
        if (blockedObject(px, py, 545, 205, 533, 557, 193, 220)) {
            return true;
        }
        if (blockedObject(px, py, 950, 220, 938, 962, 208, 235)) {
            return true;
        }
        if (blockedObject(px, py, 990, 145, 978, 1002, 133, 160)) {
            return true;
        }

        // Casas
        if (blockedObject(px, py, 665, 55, 651, 725, 50, 93)) {
            return true;
        }
        if (blockedObject(px, py, 850, 165, 836, 910, 160, 203)) {
            return true;
        }

        // Roca
        if (overlaps(px, py, 740, 760, 195, 215)) {
            return true;
        }

        return false;
    }

    // =====================================
    // COLISIONES DEL CLARO
    // =====================================


        // Arboles
        if (blockedObject(px, py, 570, 300, 558, 582, 288, 315)) {
            return true;
        }
        if (blockedObject(px, py, 550, 420, 538, 562, 408, 435)) {
            return true;
        }
        if (blockedObject(px, py, 620, 465, 608, 632, 453, 480)) {
            return true;
        }
        if (blockedObject(px, py, 690, 470, 678, 702, 458, 485)) {
            return true;
        }
        if (blockedObject(px, py, 890, 300, 878, 902, 288, 315)) {
            return true;
        }
        if (blockedObject(px, py, 970, 300, 958, 982, 288, 315)) {
            return true;
        }
        if (blockedObject(px, py, 950, 465, 938, 962, 453, 480)) {
            return true;
        }

        // Casa
        if (blockedObject(px, py, 665, 320, 651, 725, 315, 358)) {
            return true;
        }

        // Rocas
        if (overlaps(px, py, 750, 770, 300, 320)) {
            return true;
        }
        if (overlaps(px, py, 790, 810, 335, 355)) {
            return true;
        }
        if (overlaps(px, py, 890, 910, 390, 410)) {
            return true;
        }
        if (overlaps(px, py, 730, 750, 450, 470)) {
            return true;
        }
        if (overlaps(px, py, 970, 990, 380, 400)) {
            return true;
        }

        return false;
    }

    // =====================================
    // COLISIONES DURANTE EL SALTO
    // ECO puede pasar sobre arboles y rocas,
    // pero no sobre casas, iglesia ni estanque.
    // =====================================

    method boolean isBlockedDuringJump(int px, int py) {

        // Iglesia del bosque.
        if (overlaps(px, py, 354, 402, 75, 130)) {
            return true;
        }

        // Casas: si una casa se quemo, deja de bloquear.
        if (blockedObject(px, py, 155, 65, 141, 215, 60, 103)) {
            return true;
        }

        if (blockedObject(px, py, 665, 55, 651, 725, 50, 93)) {
            return true;
        }

        if (blockedObject(px, py, 850, 165, 836, 910, 160, 203)) {
            return true;
        }

        if (blockedObject(px, py, 150, 320, 136, 210, 315, 358)) {
            return true;
        }

        if (blockedObject(px, py, 665, 320, 651, 725, 315, 358)) {
            return true;
        }

        // Estanque del claro.
        if (overlaps(px, py, 335, 385, 330, 380)) {
            return true;
        }

        return false;
    }

    // =====================================
    // COMPROBAR SI UN PUNTO ESTA DENTRO
    // DE UN RECTANGULO
    // =====================================

    method boolean overlaps(int px, int py,
                            int left, int right,
                            int top, int bottom) {

        if (px > left) {
            if (px < right) {
                if (py > top) {
                    if (py < bottom) {
                        return true;
                    }
                }
            }
        }

        return false;
    }
}
